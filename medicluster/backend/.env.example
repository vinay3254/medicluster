# ── Database / core ──────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend only: service_role JWT or sb_secret_ key. Never put this in Vite variables.
SUPABASE_SECRET_KEY=
# Legacy alternative if using a service_role JWT:
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Management API token for npm run db:apply (SQL Editor also works).
SUPABASE_ACCESS_TOKEN=
ML_ENGINE_URL=http://localhost:8000
# Optional brain MRI inference from the separate Brain Health Monitor workstation.
# Start its server locally on port 8001; leave blank to hide the Brain MRI option.
BRAIN_MRI_URL=
PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret
# Exact clinician access emails, comma-separated. Restricts registration, login and existing sessions.
# Overrides domain access when set. Configure only the staff who should have access.
ALLOWED_STAFF_EMAILS=
# Optional domain-based registration when no exact emails are configured.
ALLOWED_EMAIL_DOMAINS=

# ── Patient OTP delivery ────────────────────────────────────────────────────
# android: paired Android SMS Sender app; disabled: no real SMS delivery.
OTP_DELIVERY_MODE=disabled
# Random secret shared only with sender phone (at least 32 characters).
SMS_GATEWAY_TOKEN=
# Local log-only testing; ignored for Android mode and NODE_ENV=production.
OTP_DEV_LOG=false

# ── Patient email OTP (EmailJS) ──────────────────────────────────────────────
# Connect sender in EmailJS and enable API requests from non-browser apps.
# OTP template recipient: {{email}}; body: email-templates/patient-otp.html
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional unless private-key authorization is enabled in EmailJS security settings.
EMAILJS_PRIVATE_KEY=

# ── Patient Google sign-in (Google OAuth Web application client) ─────────────
# Production: public HTTPS origin, without path. Local: http://localhost:3000
# Authorized redirect URI: <PATIENT_PUBLIC_ORIGIN>/api/patient-auth/google/callback
PATIENT_PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM provider (Ollama) ────────────────────────────────────────────────────
# Operation mode:
#   cloud  → use Ollama Cloud only (no local daemon ever).
#   local  → use local daemon only, ignore any cloud keys.
#   auto   → whichever is reachable (default).
OLLAMA_MODE=cloud

# Base URL for the Ollama daemon or Ollama Cloud.
#   Local daemon:        http://localhost:11434
#   Ollama Cloud:        https://ollama.com
OLLAMA_URL=https://ollama.com

# API key(s) for Ollama Cloud. Provide one of:
#   OLLAMA_API_KEY       single key
#   OLLAMA_API_KEYS      comma-separated list, tried in order with rotation.
#                        Each entry supports "label|key" or "label|key|region"
#                        (label is logged, region is informational only).
#                        On a 401/403/429 from any key, the client marks it
#                        unhealthy for OLLAMA_KEY_COOLDOWN_MS (default 60s)
#                        and moves on to the next key.
# Examples:
#   OLLAMA_API_KEY=ollama_…
#   OLLAMA_API_KEYS=primary|ollama_AAA…,backup-eu|ollama_BBB…,ap-acct|ollama_CCC…|ap
OLLAMA_API_KEY=
OLLAMA_API_KEYS=

# How long (ms) a key stays disabled after a hard failure (401/403/429).
OLLAMA_KEY_COOLDOWN_MS=60000

# Default models. Leave blank to auto-detect from /api/tags (preferring
# nemotron / minimax / vision-capable names). Set these to pin specific models.
#
# Popular vision picks (auto-detected when blank):
#   minimax-m3:cloud · minimax-m2.7:cloud
#   gemma4:31b-cloud · gemma3:27b
#   qwen3-vl:8b · qwen2.5-vl:32b
#   kimi-vl · kimi-k3:cloud
#   llama3.2-vision · llava:13b
#   mistral-large-3 · pixtral:12b
#   glm-5.1:cloud · glm-4v
#   deepseek-v4-flash · nemotron-3-vl
#   internvl2:26b · molmo:7b
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=gemma4:cloud

# Comma-separated priority order for vision/text selection, e.g.
# "minimax,gemma,qwen" puts minimax models first. Leave blank for default order.
OLLAMA_PREFERRED_FAMILIES=

# ── Legacy keys (no longer used by the backend; left for reference) ───────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local 3D MRI and vital forecasting worker; use same secret in worker .env
INTELLIGENCE_URL=http://127.0.0.1:8090
INTELLIGENCE_TOKEN=

# Dedicated Python 3.12 TorchXRayVision worker (optional; falls back to ML_ENGINE_URL)
CHEST_IMAGING_URL=http://127.0.0.1:8091
